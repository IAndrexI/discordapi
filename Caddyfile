(nocache_headers) {
    @downloads path /downloads/*
    @nocache not path /downloads/*

    header @nocache {
        Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Pragma "no-cache"
        Expires "0"
    }
    header @downloads {
        Cache-Control "public, max-age=3600"
    }
}

:8008 {
    import nocache_headers

    @selfhosted_sse {
        path /api/events*
    }
    handle @selfhosted_sse {
        reverse_proxy localhost:4175 {
            flush_interval -1
        }
    }

    @selfhosted_api {
        path /api/health* /api/auth* /api/account* /api/bootstrap* /api/rooms* /api/guilds* /api/soundboard* /api/discord/* /api/voice/token* /api/minecraft* /api/scripts* /api/webhooks* /api/files* /api/search* /api/proxy-page* /api/cobrowse*
    }
    handle @selfhosted_api {
        reverse_proxy localhost:4175
    }

    handle /api/* {
        reverse_proxy localhost:8089
    }
    handle /livekit/* {
        uri strip_prefix /livekit
        reverse_proxy localhost:7880
    }
    handle /rtc* {
        reverse_proxy localhost:7880
    }
    handle /_matrix/static/* {
        uri strip_prefix /_matrix/static
        root * /var/www/discord-guide
        file_server
    }
    handle /_matrix/* {
        reverse_proxy localhost:8007
    }
    handle /_synapse/* {
        reverse_proxy localhost:8007
    }
    handle /.well-known/* {
        reverse_proxy localhost:8007
    }
    redir /chat /chat/
    handle /chat/* {
        uri strip_prefix /chat
        root * /var/www/discord-client
        try_files {path} /index.html
        file_server
    }
    redir /app /app/
    handle /app/* {
        uri strip_prefix /app
        root * /var/www/discord-client
        try_files {path} /index.html
        file_server
    }
    handle /setup* {
        uri strip_prefix /setup
        root * /var/www/discord-guide
        try_files {path} /index.html
        file_server
    }
    handle /portal* {
        uri strip_prefix /portal
        root * /var/www/discord-guide
        try_files {path} /index.html
        file_server
    }
    @portal_tools {
        path /sync.ps1 /discord-qr.html /server-select.html /guilds.json /discord-theme.json /logo.jpg /version.json
    }
    handle @portal_tools {
        root * /var/www/discord-guide
        file_server
    }
    handle {
        root * /var/www/discord-guide
        try_files {path} /index.html
        file_server
    }
}

