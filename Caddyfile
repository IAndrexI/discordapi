:8008 {
    handle /api/* {
        reverse_proxy localhost:8089
    }
    handle /_matrix/static/* {
        uri strip_prefix /_matrix/static
        root * /var/www/discord-guide
        file_server
    }
    @portal {
        path / /index.html /logo.jpg /favicon.ico /sync.ps1 /discord-qr.html /server-select.html /guilds.json
    }
    handle @portal {
        root * /var/www/discord-guide
        file_server
    }
    handle {
        reverse_proxy localhost:8007
    }
}

