{
  "name": "protutech",
  "private": true,
  "version": "1.0.1",
  "author": "Protutech",
  "description": "Ultra-low latency voice, video, and community chat platform",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "sync:downloads": "node scripts/sync-downloads.cjs",
    "electron:build": "npm run build && electron-builder --win portable nsis && node scripts/sync-downloads.cjs",
    "electron:build:portable": "npm run build && electron-builder --win portable && node scripts/sync-downloads.cjs",
    "electron:build:store": "npm run build && electron-builder --win appx && node scripts/sync-downloads.cjs",
    "electron:build:linux": "npm run build && electron-builder --linux AppImage deb tar.gz && node scripts/sync-downloads.cjs",
    "electron:build:all": "npm run build && electron-builder -wl && node scripts/sync-downloads.cjs"
  },
  "build": {
    "appId": "vip.protutech.chat",
    "productName": "ProtutechChat",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "portable",
        "nsis",
        "appx"
      ]
    },
    "appx": {
      "applicationId": "ProtutechChat",
      "identityName": "Protutech.200542756E8C1",
      "displayName": "ProtutechChat",
      "publisher": "CN=E81D70C0-1117-411E-AE08-9C9DEEEC2C88",
      "publisherDisplayName": "Protutech",
      "backgroundColor": "#090d16",
      "showNameOnTiles": true,
      "artifactName": "ProtutechChat-Store.appx"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "ProtutechChat-Setup.exe"
    },
    "portable": {
      "artifactName": "ProtutechChat-Portable.exe"
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Network;Chat;InstantMessaging;",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "appImage": {
      "artifactName": "ProtutechChat.AppImage"
    },
    "deb": {
      "artifactName": "ProtutechChat.deb"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
